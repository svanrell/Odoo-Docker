# ==============================================================================
# VARIABLES DE ENTORNO DEL PROYECTO (PLANTILLA .env.example)
# ==============================================================================
# Copie este archivo como .env para uso local:
#   cp .env.example .env
#
# IMPORTANTE: Las contraseñas críticas NO se definen aquí; se gestionan
# a través de Docker Secrets montados en el directorio secrets/
# ==============================================================================

# Identificadores de Base de Datos PostgreSQL
POSTGRES_DB=odoo
POSTGRES_USER=odoo

# Puertos expuestos en el Host
ODOO_HOST_PORT=8069
POSTGRES_DEV_PORT=5432
